# --- Airtable ---
# Personal access token (scopes: data.records:read, data.records:write, schema.bases:read)
AIRTABLE_TOKEN=pat_your_token
# Base id lives in config/mapping.json (airtable.baseId); token is the only secret.

# --- Supabase ---
SUPABASE_URL=https://your-project.supabase.co
# Service-role key (server-side; needed to write and to read/write sync_state)
SUPABASE_KEY=your-service-role-key

# --- Telegram (error alerts) ---
TELEGRAM_BOT_TOKEN=123456:ABC-your-token
TELEGRAM_CHAT_ID=@your_channel

# --- Behaviour ---
# Override mapping.json direction if set: two-way | airtable-to-supabase | supabase-to-airtable
SYNC_DIRECTION=
# Tolerance (ms) when comparing modified timestamps across systems with clock skew
CLOCK_SKEW_MS=1000
# Cron schedule timezone (affects the Docker cron only)
TZ=Europe/Istanbul
